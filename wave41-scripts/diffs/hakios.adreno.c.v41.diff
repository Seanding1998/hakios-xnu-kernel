+/* A completion event of the seventh generation, with its write-back: the event id, where the
+ * word goes, and the word itself (a type-7 header and four words, FENCE_EVENT first). */
+static void
+ring_fence_event(uint32_t event, uint64_t address, uint32_t word)
+{
+	ring_command(CP_EVENT_WRITE, 4);
+	ring(FENCE_EVENT(event));
+	ring((uint32_t)address);
+	ring((uint32_t)(address >> 32));
+	ring(word);
+}
